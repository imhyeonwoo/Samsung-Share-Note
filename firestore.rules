rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function member() {
      return signedIn() &&
        request.auth.token.email.lower() in
        get(/databases/$(database)/documents/workspaces/samsung-interview).data.members;
    }
    function owner() {
      return signedIn() &&
        request.auth.uid ==
        get(/databases/$(database)/documents/workspaces/samsung-interview).data.ownerUid;
    }
    match /workspaces/samsung-interview {
      allow get: if signedIn() &&
        (resource == null ||
         request.auth.uid == resource.data.ownerUid ||
         request.auth.token.email.lower() in resource.data.members);
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'members', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.members == [request.auth.token.email.lower()];
      allow update: if owner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() <= 30 &&
        request.auth.token.email.lower() in request.resource.data.members;
      allow delete: if false;
      match /{collection}/{itemId} {
        allow read, write: if collection in ['notes','tasks'] && member();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
