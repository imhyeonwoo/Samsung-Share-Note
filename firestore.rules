rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validSpace(spaceId) {
      return request.auth != null &&
        spaceId.matches('^[a-f0-9]{48}$');
    }

    // A 192-bit random workspace ID is carried in the shared URL fragment.
    // This is a link-capability model, not a substitute for individual permissions.
    // Any anonymous Firebase user who knows the workspace ID can read, edit or delete.
    match /spaces/{spaceId} {
      allow read, write: if false;

      match /pages/{pageId} {
        allow read: if validSpace(spaceId);
        allow create, update: if validSpace(spaceId) &&
          request.resource.data.keys().hasOnly([
            'id', 'title', 'icon', 'parentId', 'order',
            'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.id == pageId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 200 &&
          request.resource.data.icon is string &&
          request.resource.data.icon.size() <= 30 &&
          (request.resource.data.parentId == null || request.resource.data.parentId is string);
        allow delete: if validSpace(spaceId);
      }

      match /blocks/{blockId} {
        allow read: if validSpace(spaceId);
        allow create, update: if validSpace(spaceId) &&
          request.resource.data.keys().hasOnly([
            'id', 'pageId', 'type', 'text', 'checked', 'order',
            'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.id == blockId &&
          request.resource.data.pageId is string &&
          request.resource.data.type in [
            'text', 'h1', 'h2', 'h3', 'bullet', 'number',
            'todo', 'quote', 'code', 'divider'
          ] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 20000 &&
          request.resource.data.checked is bool;
        allow delete: if validSpace(spaceId);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}